# =============================================================================
# .env.docker — Docker Compose environment template
#
# Docker service names replace localhost/127.0.0.1 hostnames.
# Copy this file and fill in real secrets before running:
#   cp .env.docker .env.docker.local
#
# DO NOT commit .env.docker.local — it contains real credentials.
# This template file (.env.docker) is safe to commit (no real secrets).
# =============================================================================

# ---------------------------------------------------------------------------
# Site / App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:80
NEXT_PUBLIC_PRODUCT_NAME=Vantage
NEXT_PUBLIC_SITE_TITLE="Vantage Portal - MSSP Platform"
NEXT_PUBLIC_SITE_DESCRIPTION="Managed Security Service Provider platform"
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR=#ffffff
NEXT_PUBLIC_THEME_COLOR_DARK=#0a0a0a

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true
NEXT_PUBLIC_LANGUAGE_PRIORITY=application
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true
NEXT_PUBLIC_LOCALES_PATH=apps/web/public/locales

# ---------------------------------------------------------------------------
# Supabase — service names substituted for Docker networking
# In local compose, Supabase runs via its own managed containers.
# Point these at the compose service or remote Supabase project as needed.
# ---------------------------------------------------------------------------
# For local Supabase via `pnpm supabase:web:start` (host network):
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
# Development anon key (safe to commit — Supabase demo project default)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Service role key — REPLACE with real value; never commit real keys
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres URL (used by Supabase CLI, Prisma, or migrations)
# When running the postgres compose service:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# ---------------------------------------------------------------------------
# NATS JetStream (compose service name: nats)
# ---------------------------------------------------------------------------
NATS_URL=nats://nats:4222

# ---------------------------------------------------------------------------
# Redis (optional — session/cache layer)
# Uncomment if redis service is enabled in docker-compose.yml
# ---------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Licensing
# ---------------------------------------------------------------------------
# LICENSE_SECRET_KEY=REPLACE_WITH_HMAC_SECRET
# LICENSE_KEY=REPLACE_WITH_TENANT_LICENSE_KEY

# ---------------------------------------------------------------------------
# Security / CSRF
# ---------------------------------------------------------------------------
# CSRF_SECRET=REPLACE_WITH_32_CHAR_SECRET

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
